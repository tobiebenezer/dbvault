# ==============================================================================
# DBVault Appliance Environment Configuration (.env.example)
# Copy this file to .env and adjust values for your environment.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DBVault Internal Appliance State (System Database)
# ------------------------------------------------------------------------------
# Option A: Dedicated PostgreSQL for DBVault internal metadata (Multi-node / HA)
# DBVAULT_DATABASE_URL=postgresql://dbvault_app:secret_password@127.0.0.1:5432/dbvault_internal

# Option B: Local filesystem data directory for embedded SQLite catalogue
DBVAULT_DATA_DIR=/var/lib/dbvault

# Directory for staging chunking, decompression, and encrypted scratch files
DBVAULT_SCRATCH=/var/lib/dbvault/scratch

# Master AEAD AES-256 Encryption Key file path
DBVAULT_KEY_FILE=/run/secrets/dbvault_master_key

# ------------------------------------------------------------------------------
# 2. Server & Web Console Network Configuration
# ------------------------------------------------------------------------------
# Host and port for the DBVault appliance server (web UI & REST API)
DBVAULT_LISTEN=127.0.0.1:8080

# Public URL used for alerts, webhooks, and recovery runbooks
DBVAULT_PUBLIC_URL=http://127.0.0.1:8080

# Pre-shared API controller bearer token (optional; auto-generated if blank)
# DBVAULT_CONTROLLER_TOKEN=dbv_sec_live_9f83bf871a2e4c02919d6756

# ------------------------------------------------------------------------------
# 3. Offsite Object Storage Targets (Managed via Web UI)
# ------------------------------------------------------------------------------
# Cloud storage destinations (Cloudflare R2, AWS S3, Contabo, MinIO, Wasabi)
# are configured and verified directly in the Web Console:
#   http://127.0.0.1:8080/repositories -> "Add Storage Destination"
#
# No hardcoded S3 credentials or server restarts are required.

# ------------------------------------------------------------------------------
# 4. Target Backup Databases (Managed via Web UI)
# ------------------------------------------------------------------------------
# Target databases (PostgreSQL, MySQL, SQLite) to protect and back up are
# discovered and managed dynamically in the Web Console:
#   http://127.0.0.1:8080/databases -> "Connect & Discover Databases"
#
# Or probe them from the terminal CLI:
#   dbvault probe --engine postgres --host 127.0.0.1 --port 5432 --user postgres --password "secret"
